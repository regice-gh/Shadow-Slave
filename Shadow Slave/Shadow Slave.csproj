  <ItemGroup>
    <ProjectReference Include="..\ShadowSlave.Shared\ShadowSlave.Shared.csproj" />
    <ProjectReference Include="..\ShadowSlaveAPI\ShadowSlave.API.csproj" />
  </ItemGroup>

</Project>
